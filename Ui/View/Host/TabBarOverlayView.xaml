<Window x:Class="_1RM.View.Host.TabBarOverlayView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:attachProperty="clr-namespace:Shawn.Utils.WpfResources.Theme.AttachProperty;assembly=Shawn.Utils.WpfResources"
        xmlns:host="clr-namespace:_1RM.View.Host"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance host:TabWindowViewModel}"
        Title="TabBarOverlay" Height="32" Width="640"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Background="Transparent"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <!--
      A separate top-level window owned by TabWindowView: it must be a distinct HWND because WPF
      content cannot paint over the remote clients' native child windows in the same window (airspace),
      while an owned window floats above its owner and all of its children. Showing it therefore
      covers part of the remote picture instead of pushing the content down - which keeps the
      remote resolution fixed while the bar comes and goes.
    -->
    <Window.Resources>
        <ItemsPanelTemplate x:Key="HorizontalItemsPanel">
            <host:ShrinkingTabPanel Orientation="Horizontal"
                                    ViewportLength="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                    MinTabLength="38" MaxTabLength="180" CompressThreshold="68" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="VerticalItemsPanel">
            <host:ShrinkingTabPanel Orientation="Vertical"
                                    ViewportLength="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                    MinTabLength="38" MaxTabLength="150" CompressThreshold="62" />
        </ItemsPanelTemplate>

        <Style x:Key="HorizontalTabContainerStyle" TargetType="ListBoxItem">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderThickness="0 0 0 2" BorderBrush="Transparent">
                            <Grid>
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                                <Rectangle Width="1" HorizontalAlignment="Right" Margin="0 6"
                                           Fill="{DynamicResource DefaultBorderBrush}" Opacity="0.35" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryLightBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryDarkBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentMidBrush}" />
                            </Trigger>
                            <Trigger Property="host:TabBarOverlayView.IsTabDragging" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryDarkBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentLightBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VerticalLeftTabContainerStyle" TargetType="ListBoxItem">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderThickness="3 0 0 0" BorderBrush="Transparent">
                            <Grid>
                                <ContentPresenter VerticalAlignment="Stretch" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                <Rectangle Height="1" VerticalAlignment="Bottom" Margin="5 0"
                                           Fill="{DynamicResource DefaultBorderBrush}" Opacity="0.35" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryLightBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryDarkBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentMidBrush}" />
                            </Trigger>
                            <Trigger Property="host:TabBarOverlayView.IsTabDragging" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryDarkBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentLightBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VerticalRightTabContainerStyle" TargetType="ListBoxItem">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderThickness="0 0 3 0" BorderBrush="Transparent">
                            <Grid>
                                <ContentPresenter VerticalAlignment="Stretch" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                <Rectangle Height="1" VerticalAlignment="Bottom" Margin="5 0"
                                           Fill="{DynamicResource DefaultBorderBrush}" Opacity="0.35" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryLightBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryDarkBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentMidBrush}" />
                            </Trigger>
                            <Trigger Property="host:TabBarOverlayView.IsTabDragging" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryDarkBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentLightBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabInlineCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBarAccentStyle}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Path=(host:ShrinkingTabPanel.IsCompressed), RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False" />
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Collapsed" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="HorizontalTabItemTemplate">
            <Grid Height="30" Background="Transparent" Margin="6 0 6 0"
                  ToolTip="{Binding DisplayName, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="{Binding IconImg}" Width="14" Height="14" Margin="0 0 4 0" VerticalAlignment="Center">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IconImg}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
                <TextBlock Grid.Column="1" Text="{Binding DisplayName, Mode=OneWay}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource PrimaryTextBrush}" />
                <Button Grid.Column="2" Width="12" Height="12" Margin="4 0 0 0" VerticalAlignment="Center"
                        Focusable="False"
                        ToolTip="{DynamicResource Close}"
                        Style="{StaticResource TabInlineCloseButtonStyle}"
                        Background="Transparent"
                        attachProperty:VisionElement.Opacity="0.5"
                        attachProperty:VisionElement.OpacityAccent="0.9"
                        attachProperty:VisionElement.BackgroundAccent="Transparent"
                        Command="{Binding DataContext.CmdClose, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        CommandParameter="{Binding Content.ConnectionId}">
                    <Path Data="F1 M 47.910156 -44.000000 L 87.183594 -4.683594 L 83.316406 -0.816406 L 44.000000 -40.089844 L 4.683594 -0.816406 L 0.816406 -4.683594 L 40.089844 -44.000000 L 0.816406 -83.316406 L 4.683594 -87.183594 L 44.000000 -47.910156 L 83.316406 -87.183594 L 87.183594 -83.316406 Z "
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=Button}}"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=Button}}"
                          StrokeThickness="2" Stretch="Uniform" />
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="VerticalTabItemTemplate">
            <Grid Background="Transparent" Margin="0 4 0 4"
                  ToolTip="{Binding DisplayName, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Image Grid.Row="0" Source="{Binding IconImg}" Width="14" Height="14" Margin="0 0 0 3" HorizontalAlignment="Center">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IconImg}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
                <host:VerticalTextPresenter Grid.Row="1"
                                          Text="{Binding DisplayName, Mode=OneWay}"
                                          Foreground="{DynamicResource PrimaryTextBrush}"
                                          FontFamily="{DynamicResource GlobalFontFamily}"
                                          FontSize="11.5"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Stretch" />
                <Button Grid.Row="2" Width="12" Height="12" Margin="0 3 0 0" HorizontalAlignment="Center"
                        Focusable="False"
                        ToolTip="{DynamicResource Close}"
                        Style="{StaticResource TabInlineCloseButtonStyle}"
                        Background="Transparent"
                        attachProperty:VisionElement.Opacity="0.5"
                        attachProperty:VisionElement.OpacityAccent="0.9"
                        attachProperty:VisionElement.BackgroundAccent="Transparent"
                        Command="{Binding DataContext.CmdClose, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        CommandParameter="{Binding Content.ConnectionId}">
                    <Path Data="F1 M 47.910156 -44.000000 L 87.183594 -4.683594 L 83.316406 -0.816406 L 44.000000 -40.089844 L 4.683594 -0.816406 L 0.816406 -4.683594 L 40.089844 -44.000000 L 0.816406 -83.316406 L 4.683594 -87.183594 L 44.000000 -47.910156 L 83.316406 -87.183594 L 87.183594 -83.316406 Z "
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=Button}}"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=Button}}"
                          StrokeThickness="2" Stretch="Uniform" />
                </Button>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder"
            BorderBrush="{DynamicResource DefaultBorderBrush}"
            BorderThickness="1"
            Background="{DynamicResource PrimaryMidBrush}">
        <Border.ContextMenu>
            <ContextMenu x:Name="BarContextMenu" StaysOpen="False">
                <MenuItem x:Name="MenuDockTop" Header="{DynamicResource 'Dock to top'}" Tag="Top" Click="DockMenuItem_OnClick">
                    <MenuItem.Icon>
                        <Path Width="11" Height="11" Stretch="Uniform" Fill="{DynamicResource PrimaryTextBrush}"
                              Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=MenuItem}, Converter={StaticResource ConverterBool2Visible}}"
                              Data="M 1,5 L 4.5,8.5 L 11,1.5 L 9.8,0.3 L 4.5,6.1 L 2.2,3.8 Z" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="MenuDockLeft" Header="{DynamicResource 'Dock to left'}" Tag="Left" Click="DockMenuItem_OnClick">
                    <MenuItem.Icon>
                        <Path Width="11" Height="11" Stretch="Uniform" Fill="{DynamicResource PrimaryTextBrush}"
                              Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=MenuItem}, Converter={StaticResource ConverterBool2Visible}}"
                              Data="M 1,5 L 4.5,8.5 L 11,1.5 L 9.8,0.3 L 4.5,6.1 L 2.2,3.8 Z" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="MenuDockRight" Header="{DynamicResource 'Dock to right'}" Tag="Right" Click="DockMenuItem_OnClick">
                    <MenuItem.Icon>
                        <Path Width="11" Height="11" Stretch="Uniform" Fill="{DynamicResource PrimaryTextBrush}"
                              Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=MenuItem}, Converter={StaticResource ConverterBool2Visible}}"
                              Data="M 1,5 L 4.5,8.5 L 11,1.5 L 9.8,0.3 L 4.5,6.1 L 2.2,3.8 Z" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="MenuDockFloat" Header="{DynamicResource 'Float freely'}" Tag="Float" Click="DockMenuItem_OnClick">
                    <MenuItem.Icon>
                        <Path Width="11" Height="11" Stretch="Uniform" Fill="{DynamicResource PrimaryTextBrush}"
                              Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=MenuItem}, Converter={StaticResource ConverterBool2Visible}}"
                              Data="M 1,5 L 4.5,8.5 L 11,1.5 L 9.8,0.3 L 4.5,6.1 L 2.2,3.8 Z" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <CheckBox Content="{DynamicResource 'Pin tab bar (disable auto-hide, always visible)'}"
                          IsChecked="{Binding IsTabBarOverlayPinned, Mode=TwoWay}" />
                <CheckBox Content="{DynamicResource 'Auto-hide the tab bar; move the mouse to the top edge of the window to show it'}"
                          IsChecked="{Binding SettingsPage.GeneralSettingViewModel.TabWindowAutoHideTabBar}" />
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- main content grid: switched between 1x4 horizontal and 5x1 vertical in code-behind -->
            <Grid x:Name="ContentGrid" Grid.Row="0" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- drag handle: move the bar and drop on top / left / right edge to dock -->
                <Border x:Name="DragGrip" Grid.Row="0" Grid.Column="0" Width="18" Background="Transparent" Cursor="SizeAll"
                        ToolTip="{DynamicResource 'Drag to move; drop on top/left/right edge to dock'}">
                    <Path VerticalAlignment="Center" HorizontalAlignment="Center" Fill="{DynamicResource PrimaryTextBrush}" Opacity="0.6"
                          RenderTransformOrigin="0.5,0.5"
                          Data="M 3.5,2.2 A 1.3,1.3 0 1 1 3.49,2.2 Z M 8.5,2.2 A 1.3,1.3 0 1 1 8.49,2.2 Z M 3.5,7.7 A 1.3,1.3 0 1 1 3.49,7.7 Z M 8.5,7.7 A 1.3,1.3 0 1 1 8.49,7.7 Z M 3.5,13.2 A 1.3,1.3 0 1 1 3.49,13.2 Z M 8.5,13.2 A 1.3,1.3 0 1 1 8.49,13.2 Z "
                          Stretch="None">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="DragGripRotate" Angle="0" />
                        </Path.RenderTransform>
                    </Path>
                </Border>

                <ListBox x:Name="TabStrip" Grid.Row="0" Grid.Column="1"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         IsSynchronizedWithCurrentItem="False"
                         ItemsPanel="{StaticResource HorizontalItemsPanel}"
                         ItemContainerStyle="{StaticResource HorizontalTabContainerStyle}"
                         ItemTemplate="{StaticResource HorizontalTabItemTemplate}"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.CanContentScroll="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.Resources>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource ScrollViewMiniStyle}">
                            <Setter Property="attachProperty:VisionElement.ForegroundAccent" Value="{DynamicResource PrimaryTextBrush}" />
                            <Setter Property="attachProperty:VisionElement.BackgroundAccent" Value="{DynamicResource PrimaryTextBrush}" />
                        </Style>
                    </ListBox.Resources>
                </ListBox>

                <Button x:Name="BtnAllTabs" Grid.Row="0" Grid.Column="2"
                        Width="22" Height="30" Background="Transparent" Focusable="False"
                        Visibility="{Binding BtnCloseAllVisibility}"
                        ToolTip="{DynamicResource 'Show all open tabs'}"
                        Style="{StaticResource ButtonBarPrimaryStyle}"
                        Click="BtnAllTabs_OnClick">
                    <Path Width="8" Height="5" Stretch="Uniform"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=Button}}"
                          Data="M 0,0 L 8,0 L 4,5 Z" />
                </Button>

                <Border x:Name="ButtonsSeparator" Grid.Row="3" Grid.Column="0" Height="1" Margin="5 2"
                        Background="{DynamicResource DefaultBorderBrush}" Opacity="0.5"
                        Visibility="Collapsed" />

                <StackPanel x:Name="ActionButtonsPanel" Grid.Row="0" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="PinCheckBox"
                              IsChecked="{Binding IsTabBarOverlayPinned, Mode=TwoWay}">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox" BasedOn="{StaticResource CheckBoxBaseStyle}">
                                <Setter Property="Width" Value="30" />
                                <Setter Property="Height" Value="30" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="ToolTip" Value="{DynamicResource 'Pin tab bar (disable auto-hide, always visible)'}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate>
                                            <Grid Name="Grid" Background="{TemplateBinding Background}">
                                                <Path Height="13" Width="13" Stretch="Uniform" Fill="{DynamicResource PrimaryTextBrush}"
                                                      Data="F1 M 14.375 11.25 C 14.980469 11.25 15.548502 11.363933 16.079102 11.591797 C 16.609699 11.819662 17.073566 12.132162 17.470703 12.529297 C 17.867838 12.926433 18.180338 13.3903 18.408203 13.920898 C 18.636066 14.451498 18.75 15.019531 18.75 15.625 C 18.75 16.230469 18.636066 16.798502 18.408203 17.329102 C 18.180338 17.859701 17.867838 18.323568 17.470703 18.720703 C 17.073566 19.117838 16.609699 19.430338 16.079102 19.658203 C 15.548502 19.886068 14.980469 20 14.375 20 C 13.769531 20 13.201497 19.886068 12.670898 19.658203 C 12.140299 19.430338 11.676432 19.117838 11.279297 18.720703 C 10.882161 18.323568 10.569661 17.859701 10.341797 17.329102 C 10.113932 16.798502 10 16.230469 10 15.625 C 10 15.019531 10.113932 14.451498 10.341797 13.920898 C 10.569661 13.3903 10.882161 12.926433 11.279297 12.529297 C 11.676433 12.132162 12.140299 11.819662 12.670898 11.591797 C 13.201497 11.363933 13.769531 11.25 14.375 11.25 Z M 11.25 15.625 C 11.25 16.054688 11.33138 16.459961 11.494141 16.84082 C 11.6569 17.22168 11.879883 17.553711 12.163086 17.836914 C 12.446289 18.120117 12.77832 18.3431 13.15918 18.505859 C 13.540039 18.668619 13.945312 18.75 14.375 18.75 C 14.680989 18.75 14.980469 18.706055 15.273438 18.618164 C 15.566406 18.530273 15.839844 18.401693 16.09375 18.232422 L 11.767578 13.90625 C 11.598307 14.160156 11.469727 14.433594 11.381836 14.726562 C 11.293945 15.019531 11.25 15.319011 11.25 15.625 Z M 16.982422 17.34375 C 17.151691 17.089844 17.280273 16.816406 17.368164 16.523438 C 17.456055 16.230469 17.5 15.93099 17.5 15.625 C 17.5 15.195312 17.416992 14.791667 17.250977 14.414062 C 17.084961 14.036459 16.860352 13.706055 16.577148 13.422852 C 16.293945 13.139648 15.963541 12.915039 15.585938 12.749023 C 15.208333 12.583008 14.804688 12.5 14.375 12.5 C 14.06901 12.5 13.76953 12.543945 13.476562 12.631836 C 13.183593 12.719727 12.910155 12.848308 12.65625 13.017578 Z M 19.433594 7.304688 C 19.21875 7.519531 19.008789 7.716472 18.803711 7.895508 C 18.598633 8.074545 18.387043 8.225912 18.168945 8.349609 C 17.950846 8.473308 17.713215 8.569336 17.456055 8.637695 C 17.198893 8.706055 16.907551 8.740234 16.582031 8.740234 C 16.360676 8.740234 16.149088 8.720703 15.947266 8.681641 L 14.638672 10 L 12.861328 10 L 15.576172 7.285156 L 15.673828 7.314453 C 15.823567 7.360026 15.973307 7.400717 16.123047 7.436523 C 16.272785 7.472332 16.425781 7.490235 16.582031 7.490234 C 16.940104 7.490235 17.278645 7.4056 17.597656 7.236328 L 12.763672 2.402344 C 12.5944 2.721355 12.509765 3.059896 12.509766 3.417969 C 12.509765 3.574219 12.527668 3.727215 12.563477 3.876953 C 12.599283 4.026693 12.639974 4.176433 12.685547 4.326172 L 12.714844 4.423828 L 7.910156 9.21875 C 7.753906 9.153646 7.604166 9.091797 7.460938 9.033203 C 7.317708 8.974609 7.174479 8.925781 7.03125 8.886719 C 6.888021 8.847656 6.739909 8.816732 6.586914 8.793945 C 6.433919 8.771159 6.269531 8.759766 6.09375 8.759766 C 5.722656 8.759766 5.361328 8.813477 5.009766 8.920898 C 4.658203 9.02832 4.332682 9.186198 4.033203 9.394531 L 8.75 14.111328 L 8.75 15.888672 L 6.875 14.003906 L 1.328125 19.560547 L 0 20 L 0.439453 18.671875 L 5.996094 13.125 L 2.226562 9.355469 L 2.666016 8.916016 C 3.121745 8.460287 3.649088 8.111979 4.248047 7.871094 C 4.847005 7.630209 5.46875 7.509766 6.113281 7.509766 C 6.367188 7.509766 6.619466 7.530925 6.870117 7.573242 C 7.120768 7.615561 7.369792 7.675782 7.617188 7.753906 L 11.318359 4.052734 C 11.279297 3.850912 11.259766 3.639324 11.259766 3.417969 C 11.259766 3.098959 11.293945 2.810873 11.362305 2.553711 C 11.430664 2.296551 11.526692 2.057293 11.650391 1.835938 C 11.774088 1.614584 11.925455 1.401367 12.104492 1.196289 C 12.283528 0.991211 12.480469 0.78125 12.695312 0.566406 Z "
                                                      VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="ToolTip" Value="{DynamicResource 'Unpin tab bar (re-enable auto-hide)'}" />
                                        <Setter Property="Background" Value="{DynamicResource AccentMidBrush}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate>
                                                    <Grid Name="Grid" Background="{TemplateBinding Background}">
                                                        <Path Height="11" Width="11" Stretch="Uniform" Fill="{DynamicResource AccentTextBrush}"
