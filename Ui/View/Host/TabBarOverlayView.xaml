                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>

                    <Button ToolTip="{DynamicResource 'Full-screen'}"
                            Command="{Binding CmdHostGoFullScreen}"
                            Width="30" Height="30" Background="Transparent" Focusable="False">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ButtonBarPrimaryStyle}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowResizeMode}" Value="NoResize">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid Height="13" Width="13">
                            <Path Data="F1 M 82.500000 -82.500000 L 82.500000 -55.000000 L 77.000000 -55.000000 L 77.000000 -73.089844 L 14.910156 -11.000000 L 33.000000 -11.000000 L 33.000000 -5.500000 L 5.500000 -5.500000 L 5.500000 -33.000000 L 11.000000 -33.000000 L 11.000000 -14.910156 L 73.089844 -77.000000 L 55.000000 -77.000000 L 55.000000 -82.500000 Z "
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=Button}}" StrokeThickness="1" Stretch="Uniform" />
                        </Grid>
                    </Button>

                    <Button ToolTip="{DynamicResource 'Close all'}"
                            Command="{Binding CmdCloseAll}"
                            Width="30" Height="30" Background="Transparent" Focusable="False"
                            Style="{StaticResource ButtonBarPrimaryStyle}"
                            attachProperty:VisionElement.ForegroundAccent="White"
                            attachProperty:VisionElement.BackgroundAccent="Red"
                            attachProperty:VisionElement.ForegroundOnMouseDown="White"
                            attachProperty:VisionElement.BackgroundOnMouseDown="Red"
                            Visibility="{Binding BtnCloseAllVisibility}">
                        <Grid Height="13" Width="13">
                            <Path Data="F1 M 87.871094 -29.003906 L 75.410156 -16.500000 L 87.871094 -3.996094 L 84.003906 -0.128906 L 71.500000 -12.589844 L 58.996094 -0.128906 L 55.128906 -3.996094 L 67.589844 -16.500000 L 55.128906 -29.003906 L 58.996094 -32.871094 L 71.500000 -20.410156 L 84.003906 -32.871094 Z M 82.500000 -77.000000 L 82.500000 -38.500000 L 49.500000 -38.500000 L 49.500000 -5.500000 L 11.000000 -5.500000 L 11.000000 -77.000000 Z M 16.500000 -71.500000 L 16.500000 -44.000000 L 44.000000 -44.000000 L 44.000000 -71.500000 Z M 44.000000 -11.000000 L 44.000000 -38.500000 L 16.500000 -38.500000 L 16.500000 -11.000000 Z M 77.000000 -44.000000 L 77.000000 -71.500000 L 49.500000 -71.500000 L 49.500000 -44.000000 Z "
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=Button}}" StrokeThickness="1" Stretch="Uniform" />
                        </Grid>
                    </Button>

                    <Button x:Name="BtnRefitResolution"
                            ToolTip="{DynamicResource 'Fit the remote resolution to the window now'}"
                            Command="{Binding CmdRefitResolution}"
                            Width="30" Height="30" Background="Transparent" Focusable="False"
                            Style="{StaticResource ButtonBarPrimaryStyle}">
                        <Grid Height="13" Width="13">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=Button}}"
                                  StrokeThickness="1.5" Stretch="Uniform"
                                  Data="M 0,4 L 0,0 L 4,0 M 11,0 L 15,0 L 15,4 M 15,11 L 15,15 L 11,15 M 4,15 L 0,15 L 0,11" />
                            <Rectangle Width="4" Height="4" Stroke="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=Button}}" StrokeThickness="1.5" />
                        </Grid>
                    </Button>

                    <Button ToolTip="{DynamicResource 'Minimize'}"
                            Command="{Binding CmdGoMinimize}"
                            Width="30" Height="30" Background="Transparent" Focusable="False"
                            Style="{StaticResource ButtonBarPrimaryStyle}">
                        <Rectangle Width="10" Height="1" Stroke="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Button}, Path=Foreground}" StrokeThickness="0.5" />
                    </Button>

                    <Button ToolTip="{DynamicResource 'Restore'}"
                            Command="{Binding CmdGoMaximize}"
                            Width="30" Height="30" Background="Transparent" Focusable="False">
                        <Button.InputBindings>
                            <MouseBinding Gesture="RightClick" Command="{Binding CmdGoMaximizeF11}" />
                        </Button.InputBindings>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ButtonBarPrimaryStyle}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowResizeMode}" Value="NoResize">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Height="10" Width="10"
                              StrokeThickness="1"
                              Stroke="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Button}, Path=Foreground}"
                              Data="M2,2 L2,0 L8,0 L8,6 L6,6 M0,2 L6,2 L6,8 L0,8 Z"
                              Stretch="Uniform" />
                    </Button>

                    <Button ToolTip="{DynamicResource Close}"
                            Width="30" Height="30" Background="Transparent" Focusable="False"
                            Command="{Binding CmdClose}"
                            Style="{StaticResource ButtonBarPrimaryStyle}"
                            attachProperty:VisionElement.ForegroundAccent="White"
                            attachProperty:VisionElement.BackgroundAccent="Red"
                            attachProperty:VisionElement.ForegroundOnMouseDown="White"
                            attachProperty:VisionElement.BackgroundOnMouseDown="Red">
                        <Path Height="10" Width="10"
                              StrokeThickness="0.5"
                              Stroke="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Button}, Path=Foreground}"
                              Fill="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Button}, Path=Foreground}"
                              Data="F1 M 47.910156 -44.000000 L 87.183594 -4.683594 L 83.316406 -0.816406 L 44.000000 -40.089844 L 4.683594 -0.816406 L 0.816406 -4.683594 L 40.089844 -44.000000 L 0.816406 -83.316406 L 4.683594 -87.183594 L 44.000000 -47.910156 L 83.316406 -87.183594 L 87.183594 -83.316406 Z "
                              Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- right resize handle: visible in horizontal mode only -->
            <Border x:Name="RightResizeGrip" Grid.Row="0" Grid.Column="1" Width="6" Background="Transparent" Cursor="SizeWE"
                    ToolTip="{DynamicResource 'Drag to resize'}">
                <Rectangle Width="1" Margin="0 6" HorizontalAlignment="Center" Fill="{DynamicResource PrimaryTextBrush}" Opacity="0.35" />
            </Border>

            <!-- bottom resize handle: visible only in left/right vertical mode -->
            <Border x:Name="BottomResizeGrip" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Height="6" Background="Transparent" Cursor="SizeNS"
                    Visibility="Collapsed"
                    ToolTip="{DynamicResource 'Drag to resize'}">
                <Rectangle Height="1" Margin="6 0" VerticalAlignment="Center" Fill="{DynamicResource PrimaryTextBrush}" Opacity="0.35" />
            </Border>
        </Grid>
    </Border>
</Window>
